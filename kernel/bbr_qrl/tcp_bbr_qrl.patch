 	bbr->initialized = 1;
 
 	bbr->init_cwnd = min(0x7FU, tcp_snd_cwnd(tp));
@@ -2340,11 +2360,22 @@
 }
 
 
+static void bbr_qrl_release(struct sock *sk)
+{
+	struct bbr *bbr = inet_csk_ca(sk);
+	/* TCP may release an algorithm selected before connect, without init. */
+	if (bbr->initialized) {
+		bbr->initialized = 0;
+		bbr_qrl_detach(sk);
+	}
+}
